# FlintEye example .env for macOS
# Copy to .env and adjust values for your machine.
# Full option reference: docs/advanced/ENV_OPTIONS.md
# Boolean values accepted by the parsers: 1|0|true|false|yes|no|on|off

# API / auth
API_HOST=127.0.0.1
API_PORT=18080
# Web UI / Vite dev server
# These are read by tools/start_orchestrator_stack.py.
WEBUI_HOST=127.0.0.1
WEBUI_PORT=5173
# Optional overrides for Vite dev proxy targets:
# WEBUI_API_PROXY_TARGET=http://127.0.0.1:18080
# WEBUI_MTX_API_PROXY_TARGET=http://127.0.0.1:9997
# AUTH_PROVIDER: local|legacy_token|oidc
# Note: oidc exists in the schema but is not implemented by the API yet.
AUTH_PROVIDER=local
AUTH_VIEWER_AUTH_REQUIRED=true
AUTH_SESSION_COOKIE_NAME=orch_session
AUTH_SESSION_TTL_SEC=43200
AUTH_LOCAL_ADMIN_USERNAME=admin
AUTH_LOCAL_VIEWER_USERNAME=viewer
AUTH_SESSION_SECRET=
AUTH_LOCAL_ADMIN_PASSWORD_HASH=
AUTH_LOCAL_VIEWER_PASSWORD_HASH=
# Legacy token mode only:
# API_ADMIN_TOKEN=
# API_VIEWER_TOKEN=
# API_BEARER_TOKEN=

# UI / logging / snapshots
WEBAPP_TITLE=FlintEye
WEBAPP_SIDEBAR_TITLE=FlintEye
WEBAPP_FOOTER_TEXT=(c) 2026 Noguhiro. Sustainable Use License + additional permission.
SNAPSHOT_TIMEOUT_SEC=3.0
LOG_DIR=./logs
# LOG_LEVEL: DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_LEVEL=ERROR
LOG_RETENTION=

# MediaMTX
# Supported now: windows_service|systemd|launchd|direct|external
# Note: docker_compose exists in the schema but is not implemented by the supervisor yet.
MTX_CONTROL_MODE=launchd
MTX_SERVICE_NAME=homebrew.mxcl.mediamtx
MTX_AUTOSTART_ON_API_START=true
MTX_RTSP_BASE_URL=rtsp://127.0.0.1:8554
MTX_WEBRTC_BASE_URL=http://127.0.0.1:8889
MTX_MANAGED_ENABLED=false
# Apple Silicon Homebrew default. On Intel macOS, this is often
# /usr/local/etc/mediamtx/mediamtx.yml instead.
MTX_CONFIG_PATH=/opt/homebrew/etc/mediamtx/mediamtx.yml
# For manual/external MediaMTX management instead:
# MTX_CONTROL_MODE=external
# MTX_AUTOSTART_ON_API_START=false
# For direct-process mode instead:
# MTX_DIRECT_COMMAND=/opt/homebrew/opt/mediamtx/bin/mediamtx /opt/homebrew/etc/mediamtx/mediamtx.yml
# MTX_DIRECT_WORKDIR=

# UVC camera defaults
UVC_PROFILES=cam1
UVC_PROFILE=cam1
UVC_CAMERA_NAME=UVC-CAM-01
UVC_RTSP_URL=rtsp://127.0.0.1:8554/uvc_cam1
# UVC_INPUT_DRIVER: auto|v4l2|avfoundation|dshow
UVC_INPUT_DRIVER=avfoundation
UVC_DEVICE=0:none
UVC_FFMPEG_BIN=ffmpeg
UVC_LOGLEVEL=error
# UVC_ENCODER: auto|<ffmpeg H.264 encoder name>
UVC_ENCODER=auto
# UVC_LATENCY_PRESET: low or leave unset for normal/default behavior
# Note: the current UVC parser accepts only "low" as an explicit preset.
UVC_LATENCY_PRESET=low
# UVC_QUALITY_PRESET: high|standard|low
UVC_QUALITY_PRESET=standard
UVC_WIDTH=1280
UVC_HEIGHT=720
UVC_FPS=30
UVC_GOP=30
UVC_BFRAMES=0
UVC_FONT_SIZE=28
# Usually auto-detected on macOS. Set explicitly if drawtext fails.
# UVC_FONTFILE=/System/Library/Fonts/Supplemental/Arial Unicode.ttf

# Optional per-profile override example:
# UVC_CAM2_CAMERA_NAME=UVC-CAM-02
# UVC_CAM2_RTSP_URL=rtsp://127.0.0.1:8554/uvc_cam2
# UVC_CAM2_INPUT_DRIVER=avfoundation
# UVC_CAM2_DEVICE=1:none
# UVC_CAM2_WIDTH=1280
# UVC_CAM2_HEIGHT=720
# UVC_CAM2_FPS=30

# Optional IP camera ingest
# MTX_IP_PATHS=ipcam1
# MTX_IP_IPCAM1_SOURCE=rtsp://user:pass@192.168.1.50:554/stream1
# MTX_IP_IPCAM1_ENABLED=true

# Multiview
MV_ENABLED=false
# MV_SOURCE_MODE: env|api|hybrid
MV_SOURCE_MODE=hybrid
MV_SOURCE_PATHS=uvc_cam1
# Render missing/unready source paths as No Stream tiles instead of failing the whole multiview.
MV_AUTO_PLACEHOLDER_MISSING_SOURCES=true
MV_MTX_API_URL=http://127.0.0.1:9997/v3/paths/list
MV_INPUT_RTSP_BASE_URL=rtsp://127.0.0.1:8554
MV_OUTPUT_RTSP_BASE_URL=rtsp://127.0.0.1:8554
MV_OUTPUT_PREFIX=multiview
MV_MAX_SOURCES=32
MV_TILE_COUNT=4
MV_CANVAS_WIDTH=1920
MV_CANVAS_HEIGHT=1080
MV_GRID_COLUMNS=2
MV_FPS=20
# MV_LATENCY_PRESET: low|normal
MV_LATENCY_PRESET=low
# MV_ENCODER: auto|<ffmpeg H.264 encoder name>
MV_ENCODER=auto
# MV_QUALITY_PRESET: high|standard|low
MV_QUALITY_PRESET=standard
MV_GOP=40
MV_BFRAMES=0
MV_X264_PRESET=veryfast
MV_RESTART_BACKOFF_SEC=3
MV_INPUT_STALL_TIMEOUT_SEC=15
# MV_INPUT_STALL_TIMEOUT_OPTION: auto|rw_timeout|stimeout|timeout|none
MV_INPUT_STALL_TIMEOUT_OPTION=auto
MV_FFMPEG_BIN=ffmpeg
MV_LOGLEVEL=error
MV_VERBOSE=false
MV_MAINTENANCE_ENABLED=true
MV_MAINTENANCE_RESTART_INTERVAL_SEC=43200
MV_MAINTENANCE_ALIGN_WITH_RECORD_SEGMENTS=true
MV_MAINTENANCE_RESTART_OFFSET_SEC=2
# Optional custom slot layout examples:
# MV_SLOT_POSITIONS=0,0,960,540;960,0,960,540;0,540,960,540;960,540,960,540
# MV_VIEW_1_SLOT_POSITIONS=0,0,1920,1080

# Recording / mediamtx.yml auto-apply
MTX_RECORD_AUTO_APPLY=true
MTX_RECORD_ROOT=./recordings/mediamtx
# MTX_RECORD_FORMAT: fmp4|mpegts
MTX_RECORD_FORMAT=fmp4
MTX_RECORD_PART_DURATION=1s
MTX_RECORD_MAX_PART_SIZE=50M
MTX_RECORD_SEGMENT_DURATION=10m
MTX_RECORD_DELETE_AFTER=168h
MTX_RECORD_INCLUDE_MULTIVIEW=true
MTX_MULTI_VIEW_MAX_COUNT=16
# Leave blank to auto-use all configured camera paths.
MTX_RECORD_PATHS=
